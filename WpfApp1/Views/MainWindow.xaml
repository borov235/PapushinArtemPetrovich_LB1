<Window x:Class="SimpleCalculator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="SimpleCalculator" Height="450" Width="800">
    <Grid>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="TxtDisplay" FontSize="24" TextAlignment="Right" IsReadOnly="True" Margin="0,0,0,10" Text="0"/>

            <UniformGrid Grid.Row="1" Rows="4" Columns="4">
                <Button Content="7" Click="Number_Click" Margin="2"/>
                <Button Content="8" Click="Number_Click" Margin="2"/>
                <Button Content="9" Click="Number_Click" Margin="2"/>
                <Button Content="/" Click="Operator_Click" Margin="2"/>

                <Button Content="4" Click="Number_Click" Margin="2"/>
                <Button Content="5" Click="Number_Click" Margin="2"/>
                <Button Content="6" Click="Number_Click" Margin="2"/>
                <Button Content="*" Click="Operator_Click" Margin="2"/>

                <Button Content="1" Click="Number_Click" Margin="2"/>
                <Button Content="2" Click="Number_Click" Margin="2"/>
                <Button Content="3" Click="Number_Click" Margin="2"/>
                <Button Content="-" Click="Operator_Click" Margin="2"/>

                <Button Content="C" Click="Clear_Click" Margin="2"/>
                <Button Content="0" Click="Number_Click" Margin="2"/>
                <Button Content="=" Click="Equals_Click" Margin="2"/>
                <Button Content="+" Click="Operator_Click" Margin="2"/>
            </UniformGrid>
        </Grid>
    </Grid>
</Window>
